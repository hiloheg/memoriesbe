# Copy to .env (git-ignored) and fill in.
SERVER_PORT=8081

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Same client ID as the frontend. Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated Google accounts allowed in. Empty = any Google account with a verified email.
ALLOWED_EMAILS=

CORS_ALLOWED_ORIGINS=http://localhost:5173


# Neon PostgreSQL (use the credentials from the Neon console; never commit the real ones).
DB_URL=jdbc:postgresql://ep-example-pooler.region.aws.neon.tech/memoriesbe?sslmode=require&channelBinding=require
DB_USER=memoriesbe_user
DB_PASSWORD=change-me
# SFTPGo REST API (memoriesworker). Admin credentials are used by the backend to create camera users.
SFTPGO_URL=http://localhost:8080
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=change-me

# Cloudflare R2 (S3 compatible) where camera uploads are stored.
R2_ENDPOINT=https://7e5bc4955e44798b387139c76f36476d.r2.cloudflarestorage.com
R2_BUCKET=memories
R2_REGION=auto
R2_ACCESS_KEY=<R2 access key id>
R2_SECRET=<R2 secret>

# Shown to the photographer next to each camera's credentials.
FTP_PUBLIC_HOST=ftp.imemories.eu
FTP_PUBLIC_PORT=21
SFTP_PUBLIC_PORT=2022

# Frontend base URL used in the QR / share link.
PUBLIC_BASE_URL=http://localhost:5173
THUMB_SECRET=<thumbnail secret>

# Lemon Squeezy (payments). Webhook signing secret: 6-40 random characters, the same one you type when creating the webhook.
LEMONSQUEEZY_WEBHOOK_SECRET=<webhook signing secret>
LEMONSQUEEZY_STORE_ID=<numeric store id>
LEMONSQUEEZY_STORE_SLUG=<store subdomain>
LEMONSQUEEZY_VARIANT_1=<variant id, pack of 1 credit>
LEMONSQUEEZY_VARIANT_5=<variant id, pack of 5 credits>
LEMONSQUEEZY_VARIANT_10=<variant id, pack of 10 credits>
# The long id at the end of each variant's Share link (the buy link needs it; the numeric variant id above is for the webhook)
LEMONSQUEEZY_BUY_ID_1=<share link id, pack of 1 credit>
LEMONSQUEEZY_BUY_ID_5=<share link id, pack of 5 credits>
LEMONSQUEEZY_BUY_ID_10=<share link id, pack of 10 credits>
# true only while testing in Lemon Squeezy test mode
LEMONSQUEEZY_ALLOW_TEST=false

# Face search ("Find my photos"). The Docker image sets the model folder itself; set it only for local runs.
FACE_MODEL_DIR=models
FACE_INDEX_BATCH=10
FACE_INDEX_INTERVAL_MS=30000
FACE_MATCH_THRESHOLD=0.363
